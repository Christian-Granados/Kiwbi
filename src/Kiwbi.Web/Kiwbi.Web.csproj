<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Kiwbi.Application\Kiwbi.Application.csproj" />
    <ProjectReference Include="..\Kiwbi.Infrastructure\Kiwbi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed at design time for `dotnet ef migrations add` (Infrastructure keeps this as PrivateAssets so it doesn't flow transitively). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7c5780f3-1c8e-4166-b20f-5fbf5fab0fca</UserSecretsId>
  </PropertyGroup>

</Project>
