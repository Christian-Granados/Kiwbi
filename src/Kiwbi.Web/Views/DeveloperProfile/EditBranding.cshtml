@model Kiwbi.Web.Models.DeveloperProfile.EditDeveloperBrandingViewModel
@{
    ViewData["Title"] = "Editar marca de la promotora";
    var previewSecondary = string.IsNullOrWhiteSpace(Model.SecondaryColor) ? Model.PrimaryColor : Model.SecondaryColor;
}

<div class="kiwbi-breadcrumb mb-1">
    <span>Kiwbi</span>
    <span>/</span>
    <a asp-controller="DeveloperProfile" asp-action="Index" class="text-decoration-none">Mi promotora</a>
    <span>/</span>
    <span class="current">Editar marca</span>
</div>
<h1 class="h4 mb-4" style="font-weight:600;">Editar marca de la promotora</h1>

<div style="max-width: 46rem;">
    <form asp-controller="DeveloperProfile" asp-action="EditBranding" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3"
          style="--preview-accent: @Model.PrimaryColor; --preview-accent-2: @previewSecondary;">
        <div asp-validation-summary="ModelOnly" class="kiwbi-validation-summary"></div>

        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Logo</div>
            <div class="row g-3 align-items-center">
                <div class="col-auto d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                    {
                        <img src="@Model.LogoPath" alt="Logo" class="kiwbi-logo-preview" style="object-fit:cover;" />
                    }
                    else
                    {
                        <span class="kiwbi-logo-preview" style="background:var(--preview-accent);">?</span>
                    }
                    <div class="small text-muted" style="font-size:.7rem;max-width:9rem;">Sin logo, se usan las iniciales sobre el color primario.</div>
                </div>
                <div class="col">
                    <input type="hidden" asp-for="LogoPath" />
                    <label asp-for="LogoImageFile" class="kiwbi-dropzone" style="padding:1.25rem 1rem;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                        <strong>Arrastra el logo o haz clic para subirlo</strong>
                        <span class="small kiwbi-dropzone-filename">PNG, JPG o WEBP · máx. 10 MB</span>
                        <input asp-for="LogoImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="visually-hidden" />
                    </label>
                    <span asp-validation-for="LogoImageFile" class="kiwbi-field-error"></span>
                    <p class="small text-muted mb-0 mt-1" style="font-size:.7rem;">Opcional. Si no subes uno nuevo, se conserva el logo actual.</p>
                </div>
            </div>
        </div>

        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Colores de marca</div>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="PrimaryColor" class="form-label small fw-medium"></label>
                    <div class="kiwbi-color-field" data-color-pair data-preview-var="--preview-accent">
                        <input asp-for="PrimaryColor" type="color" class="kiwbi-color-swatch" />
                        <input type="text" class="kiwbi-color-hex" spellcheck="false" />
                    </div>
                    <span asp-validation-for="PrimaryColor" class="kiwbi-field-error"></span>
                    <p class="small text-muted mb-0 mt-1" style="font-size:.7rem;">Botones, navegación activa, acentos.</p>
                </div>
                <div class="col-sm-6">
                    <label asp-for="SecondaryColor" class="form-label small fw-medium"></label>
                    <div class="kiwbi-color-field" data-color-pair data-preview-var="--preview-accent-2">
                        <input asp-for="SecondaryColor" type="color" class="kiwbi-color-swatch" />
                        <input type="text" class="kiwbi-color-hex" spellcheck="false" />
                    </div>
                    <span asp-validation-for="SecondaryColor" class="kiwbi-field-error"></span>
                    <p class="small text-muted mb-0 mt-1" style="font-size:.7rem;">Estados hover y degradados sutiles.</p>
                </div>
            </div>

            <div class="mt-3">
                <div class="text-uppercase text-muted mb-2" style="font-size:.65rem;letter-spacing:.04em;font-weight:600;">Paletas rápidas</div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="kiwbi-palette-pill" data-palette data-primary="#2f7d5b" data-secondary="#1c5540">
                        <span class="kiwbi-palette-swatch"><span style="background:#2f7d5b;"></span><span style="background:#1c5540;"></span></span>
                        Verde bosque
                    </button>
                    <button type="button" class="kiwbi-palette-pill" data-palette data-primary="#2563a8" data-secondary="#173f6b">
                        <span class="kiwbi-palette-swatch"><span style="background:#2563a8;"></span><span style="background:#173f6b;"></span></span>
                        Azul acero
                    </button>
                    <button type="button" class="kiwbi-palette-pill" data-palette data-primary="#c05621" data-secondary="#8a3d17">
                        <span class="kiwbi-palette-swatch"><span style="background:#c05621;"></span><span style="background:#8a3d17;"></span></span>
                        Terracota
                    </button>
                    <button type="button" class="kiwbi-palette-pill" data-palette data-primary="#5b4bc4" data-secondary="#3b2f8a">
                        <span class="kiwbi-palette-swatch"><span style="background:#5b4bc4;"></span><span style="background:#3b2f8a;"></span></span>
                        Púrpura real
                    </button>
                </div>
            </div>

            <div class="mt-4 p-3 rounded-3" style="background:var(--kiwbi-bg); border:1px solid var(--kiwbi-border);">
                <div class="text-uppercase text-muted mb-3" style="font-size:.65rem;letter-spacing:.04em;font-weight:600;">Vista previa en vivo</div>
                <div class="row g-3 align-items-center">
                    <div class="col-sm-4">
                        <div class="border rounded-3 bg-white p-2" style="border-color:var(--kiwbi-border) !important;">
                            <div class="d-flex align-items-center gap-2 rounded-2 px-2 py-2 text-white small fw-medium" style="background:var(--preview-accent);">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                                Panel
                            </div>
                            <div class="d-flex align-items-center gap-2 rounded-2 px-2 py-2 small text-muted">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
                                Viviendas
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 d-flex flex-column gap-2">
                        <button type="button" class="btn btn-sm text-white d-flex align-items-center justify-content-center gap-1" style="background:var(--preview-accent);" disabled>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            Guardar cambios
                        </button>
                        <button type="button" class="btn btn-sm" style="border:1px solid var(--preview-accent); color:var(--preview-accent);" disabled>Botón secundario</button>
                    </div>
                    <div class="col-sm-4">
                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size:.7rem;">
                            <span>Progreso de obra</span><span>74%</span>
                        </div>
                        <span class="kiwbi-progress" style="width:100%;"><span style="width:74%;background:var(--preview-accent);"></span></span>
                        <span class="kiwbi-progress mt-2 d-block" style="width:100%;"><span style="width:48%;background:var(--preview-accent-2);"></span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pb-2">
            <a asp-controller="DeveloperProfile" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
