@model Kiwbi.Web.Models.DeveloperProfile.EditDeveloperProfileViewModel
@{
    ViewData["Title"] = "Editar perfil de la promotora";
}

<div class="kiwbi-breadcrumb mb-1">
    <span>Kiwbi</span>
    <span>/</span>
    <a asp-controller="DeveloperProfile" asp-action="Index" class="text-decoration-none">Mi promotora</a>
    <span>/</span>
    <span class="current">Editar perfil</span>
</div>
<h1 class="h4 mb-4" style="font-weight:600;">Editar perfil de la promotora</h1>

<div style="max-width: 32rem;">
    <form asp-controller="DeveloperProfile" asp-action="EditProfile" method="post" class="d-flex flex-column gap-3">
        <div asp-validation-summary="ModelOnly" class="kiwbi-validation-summary"></div>
        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Datos generales</div>
            <label asp-for="Name" class="form-label small fw-medium"></label>
            <input asp-for="Name" class="form-control form-control-sm" />
            <span asp-validation-for="Name" class="kiwbi-field-error"></span>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <a asp-controller="DeveloperProfile" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-kiwbi-primary btn-sm">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
