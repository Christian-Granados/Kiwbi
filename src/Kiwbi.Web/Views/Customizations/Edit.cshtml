@model Kiwbi.Web.Models.Customizations.EditCustomizationViewModel
@{
    ViewData["Title"] = "Editar personalización";
}

<div class="kiwbi-breadcrumb mb-1">
    <a asp-controller="Customizations" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">Personalización</a>
    <span>/</span>
    <span class="current">Editar nombre</span>
</div>
<h1 class="h4 mb-4" style="font-weight:600;">Editar personalización</h1>

<div style="max-width: 32rem;">
    <form asp-controller="Customizations" asp-action="Edit" method="post" class="d-flex flex-column gap-3">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TradeCategoryId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Datos generales</div>
            <label asp-for="Name" class="form-label small fw-medium"></label>
            <input asp-for="Name" class="form-control form-control-sm" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="d-flex justify-content-end gap-2 pb-2">
            <a asp-controller="Customizations" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
