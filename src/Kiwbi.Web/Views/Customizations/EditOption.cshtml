@model Kiwbi.Web.Models.Customizations.EditCustomizationOptionViewModel
@{
    ViewData["Title"] = "Editar opción";
}

<h1>Editar opción</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Customizations" asp-action="EditOption" method="post">
            <input type="hidden" asp-for="CustomizationId" />
            <input type="hidden" asp-for="OptionId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SurchargeAmount" class="form-label"></label>
                <input asp-for="SurchargeAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="SurchargeAmount" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-controller="Customizations" asp-action="Details" asp-route-id="@Model.CustomizationId" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
