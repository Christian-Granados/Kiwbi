@model Kiwbi.Web.Models.Customizations.EditCustomizationOptionViewModel
@{
    ViewData["Title"] = "Editar opción";
}

<div class="kiwbi-breadcrumb mb-1">
    <a asp-controller="Customizations" asp-action="Details" asp-route-id="@Model.CustomizationId" class="text-decoration-none">Personalización</a>
    <span>/</span>
    <span class="current">Editar opción</span>
</div>
<h1 class="h4 mb-4" style="font-weight:600;">Editar opción</h1>

<div style="max-width: 32rem;">
    <form asp-controller="Customizations" asp-action="EditOption" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">
        <input type="hidden" asp-for="CustomizationId" />
        <input type="hidden" asp-for="OptionId" />
        <div asp-validation-summary="ModelOnly" class="kiwbi-validation-summary"></div>
        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Datos de la opción</div>
            <div class="row g-3">
                <div class="col-sm-8">
                    <label asp-for="Name" class="form-label small fw-medium"></label>
                    <input asp-for="Name" class="form-control form-control-sm" />
                    <span asp-validation-for="Name" class="kiwbi-field-error"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="SurchargeAmount" class="form-label small fw-medium"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="SurchargeAmount" class="form-control" type="number" step="0.01" min="0" />
                        <span class="input-group-text">€</span>
                    </div>
                    <span asp-validation-for="SurchargeAmount" class="kiwbi-field-error"></span>
                </div>
            </div>
        </div>
        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Imagen de la opción</div>
            <div class="row g-3 align-items-start">
                <div class="col-sm-5">
                    @if (!string.IsNullOrEmpty(Model.ThumbnailImagePath))
                    {
                        <div class="kiwbi-plano-preview">
                            <img src="@Model.ThumbnailImagePath" alt="@Model.Name" class="kiwbi-plan-zoomable" />
                        </div>
                    }
                    else
                    {
                        <div class="kiwbi-plano-preview">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                            <span class="small">Sin imagen cargada</span>
                        </div>
                    }
                </div>
                <div class="col-sm-7 d-flex flex-column gap-2">
                    <label asp-for="ThumbnailImageFile" class="kiwbi-dropzone">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14.9A5 5 0 0 1 6 5.3a6.5 6.5 0 0 1 12.6 2A4.5 4.5 0 0 1 18 16H7a3 3 0 0 1-3-3Z" /><path d="M12 12v6M9 15l3-3 3 3" /></svg>
                        <strong>Arrastra una imagen o haz clic para subir</strong>
                        <span class="small kiwbi-dropzone-filename">PNG, JPG o WEBP · máx. 10 MB</span>
                        <input asp-for="ThumbnailImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="visually-hidden" />
                    </label>
                    <span asp-validation-for="ThumbnailImageFile" class="kiwbi-field-error"></span>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 pb-2">
            <a asp-controller="Customizations" asp-action="Details" asp-route-id="@Model.CustomizationId" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
