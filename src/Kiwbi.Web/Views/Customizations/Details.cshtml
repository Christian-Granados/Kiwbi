@model Kiwbi.Web.Models.Customizations.CustomizationDetailsViewModel
@using Kiwbi.Domain.Customizations
@{
    ViewData["Title"] = "Detalle de la personalización";
    string ScopeLabel(CustomizationScope scope) => scope switch
    {
        CustomizationScope.WholePromotion => "Toda la promoción",
        CustomizationScope.Typology => "Tipología",
        CustomizationScope.Unit => "Vivienda",
        _ => scope.ToString(),
    };
}

<a asp-controller="Customizations" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="d-inline-flex align-items-center gap-1 small text-muted text-decoration-none mb-2">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
    Volver al listado
</a>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="d-flex align-items-center gap-2">
        <span class="kiwbi-row-icon" style="width:2.25rem;height:2.25rem;background:var(--kiwbi-accent);color:#fff;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><circle cx="9" cy="10" r="1" /><circle cx="14" cy="8" r="1" /><circle cx="15" cy="13" r="1" /></svg>
        </span>
        <h1 class="h5 mb-0" style="font-weight:600;">@Model.Name</h1>
    </div>
    <a asp-controller="Customizations" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>
        Editar nombre
    </a>
</div>

<div class="kiwbi-table-card mb-4">
    <div class="kiwbi-table-card-header">
        <div>
            <span class="title">Opciones</span>
            <div class="small text-muted" style="font-size:.7rem;">La opción por defecto es la incluida sin sobrecoste</div>
        </div>
    </div>

    @foreach (var option in Model.Options)
    {
        <div class="kiwbi-option-row">
            @if (option.IsDefault)
            {
                <button type="button" class="kiwbi-option-star is-default" disabled title="Opción por defecto">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9 12 2" /></svg>
                </button>
            }
            else
            {
                <form asp-controller="Customizations" asp-action="SetDefaultOption" asp-route-id="@Model.Id" asp-route-optionId="@option.Id" method="post" class="d-inline">
                    <button type="submit" class="kiwbi-option-star" title="Marcar como opción por defecto">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9 12 2" /></svg>
                    </button>
                </form>
            }
            <div class="flex-fill d-flex align-items-center gap-2">
                <span class="fw-medium">@option.Name</span>
                @if (option.IsDefault)
                {
                    <span class="kiwbi-badge-accent"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg> Por defecto</span>
                }
            </div>
            @if (option.SurchargeAmount > 0)
            {
                <span class="small fw-semibold me-2" style="color:var(--kiwbi-accent);">+@option.SurchargeAmount.ToString("0.##") €</span>
            }
            else
            {
                <span class="small text-muted me-2">Incluido</span>
            }
            <div class="d-flex gap-1">
                <a asp-controller="Customizations" asp-action="EditOption" asp-route-id="@Model.Id" asp-route-optionId="@option.Id" class="btn btn-sm btn-outline-secondary" aria-label="Editar @option.Name">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>
                </a>
                @if (option.IsDefault)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" disabled title="Marca otra como opción por defecto antes de eliminarla" aria-label="Eliminar @option.Name">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                    </button>
                }
                else
                {
                    <form asp-controller="Customizations" asp-action="RemoveOption" asp-route-id="@Model.Id" asp-route-optionId="@option.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Seguro que quieres eliminar esta opción?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Eliminar @option.Name">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                        </button>
                    </form>
                }
            </div>
        </div>
    }

    <div class="kiwbi-option-add">
        <div class="small text-uppercase text-muted mb-2" style="font-size:.65rem;letter-spacing:.04em;font-weight:600;">Nueva opción</div>
        <form asp-controller="Customizations" asp-action="AddOption" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
            <div class="col-sm-6">
                <label class="form-label small fw-medium">Nombre de la opción</label>
                <input type="text" name="name" class="form-control form-control-sm" placeholder="p. ej. Porcelánico beige" required />
            </div>
            <div class="col-sm-3">
                <label class="form-label small fw-medium">Sobrecoste</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">€</span>
                    <input type="number" name="surchargeAmount" min="0" class="form-control" step="0.01" value="0" required />
                </div>
            </div>
            <div class="col-sm-3">
                <button type="submit" class="btn btn-kiwbi-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Añadir
                </button>
            </div>
        </form>
    </div>
</div>

<div class="kiwbi-table-card mb-3">
    <div class="kiwbi-table-card-header">
        <span class="title">Se aplica a</span>
        <span class="count">@Model.Assignments.Count asignaciones</span>
    </div>
    @if (!Model.Assignments.Any())
    {
        <div class="kiwbi-empty-state">
            <p>Sin asignaciones.</p>
        </div>
    }
    else
    {
        <table class="kiwbi-table">
            <thead>
                <tr>
                    <th>Nivel</th>
                    <th>Destino</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var assignment in Model.Assignments)
                {
                    <tr>
                        <td><span class="kiwbi-chip">@ScopeLabel(assignment.Scope)</span></td>
                        <td class="kiwbi-row-title">@assignment.TargetLabel</td>
                        <td class="text-end">
                            @if (Model.Assignments.Count > 1)
                            {
                                <form asp-controller="Customizations" asp-action="RemoveAssignment" asp-route-id="@Model.Id" asp-route-assignmentId="@assignment.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Seguro que quieres eliminar esta asignación?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (!Model.IsAssignedToWholePromotion)
{
    <div class="row g-3">
        <div class="col-sm-6">
            <div class="kiwbi-fieldset">
                <div class="kiwbi-legend">Añadir tipología</div>
                <form asp-controller="Customizations" asp-action="AddTypologyAssignment" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <select name="housingTypologyId" class="form-select form-select-sm" asp-items="Model.AvailableTypologies"></select>
                    <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Añadir</button>
                </form>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="kiwbi-fieldset">
                <div class="kiwbi-legend">Añadir vivienda</div>
                <form asp-controller="Customizations" asp-action="AddUnitAssignment" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <select name="housingUnitId" class="form-select form-select-sm" asp-items="Model.AvailableUnits"></select>
                    <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Añadir</button>
                </form>
            </div>
        </div>
    </div>
}
