@model List<Kiwbi.Web.Models.Customizations.CustomizationListItemViewModel>
@{
    ViewData["Title"] = "Personalizaciones";
    var promotionId = (Guid)ViewBag.PromotionId;
    var promotionName = (string)ViewBag.PromotionName;
    var tradeCategoryId = (Guid?)ViewBag.TradeCategoryId;
    var hasTradeCategories = (bool)ViewBag.HasTradeCategories;
}

<h1>Personalizaciones de @(tradeCategoryId is not null ? (string)ViewBag.TradeCategoryName : promotionName)</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p>
    @if (hasTradeCategories)
    {
        <a asp-controller="Customizations" asp-action="Create" asp-route-promotionId="@promotionId" asp-route-tradeCategoryId="@tradeCategoryId" class="btn btn-primary">Nueva personalización</a>
    }
    @if (tradeCategoryId is not null)
    {
        <a asp-controller="TradeCategories" asp-action="Index" asp-route-promotionId="@promotionId" class="btn btn-secondary">Volver a los gremios</a>
    }
    else
    {
        <a asp-controller="HousingPromotions" asp-action="Details" asp-route-id="@promotionId" class="btn btn-secondary">Volver a la promoción</a>
    }
</p>

@if (!hasTradeCategories)
{
    <p>
        Todavía no hay gremios dados de alta en esta promoción.
        <a asp-controller="TradeCategories" asp-action="Create" asp-route-promotionId="@promotionId">Crea uno primero</a> para poder dar de alta personalizaciones.
    </p>
}
else if (!Model.Any())
{
    <p>Todavía no hay personalizaciones dadas de alta.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                @if (tradeCategoryId is null)
                {
                    <th>Gremio</th>
                }
                <th>Opciones</th>
                <th>Se aplica a</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customization in Model)
            {
                <tr>
                    <td>@customization.Name</td>
                    @if (tradeCategoryId is null)
                    {
                        <td>@customization.TradeCategoryName</td>
                    }
                    <td>@customization.OptionsCount</td>
                    <td>@customization.AssignmentsSummary</td>
                    <td>
                        <a asp-controller="Customizations" asp-action="Details" asp-route-id="@customization.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
                        <form asp-controller="Customizations" asp-action="Delete" asp-route-id="@customization.Id" asp-route-promotionId="@promotionId" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que quieres eliminar esta personalización?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
