@model Kiwbi.Web.Models.Customizations.CreateCustomizationViewModel
@using Kiwbi.Domain.Customizations
@{
    ViewData["Title"] = "Nueva personalización";
}

<div class="kiwbi-breadcrumb mb-1">
    <a asp-controller="Customizations" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="text-decoration-none">Personalizaciones</a>
    <span>/</span>
    <span class="current">Nueva personalización</span>
</div>
<h1 class="h4 mb-4" style="font-weight:600;">Nueva personalización</h1>

<div style="max-width: 40rem;">
    <form asp-controller="Customizations" asp-action="Create" method="post" class="d-flex flex-column gap-3">
        <input type="hidden" asp-for="HousingPromotionId" />
        <div asp-validation-summary="ModelOnly" class="kiwbi-validation-summary"></div>

        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Datos generales</div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="TradeCategoryId" class="form-label small fw-medium"></label>
                    <select asp-for="TradeCategoryId" class="form-select form-select-sm" asp-items="Model.AvailableTradeCategories"></select>
                    <span asp-validation-for="TradeCategoryId" class="kiwbi-field-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Name" class="form-label small fw-medium"></label>
                    <input asp-for="Name" class="form-control form-control-sm" placeholder="p. ej. Tipo de suelo" />
                    <span asp-validation-for="Name" class="kiwbi-field-error"></span>
                </div>
            </div>
        </div>

        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Opción por defecto</div>
            <div class="row g-3">
                <div class="col-sm-8">
                    <label asp-for="DefaultOptionName" class="form-label small fw-medium"></label>
                    <input asp-for="DefaultOptionName" class="form-control form-control-sm" />
                    <span asp-validation-for="DefaultOptionName" class="kiwbi-field-error"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="DefaultOptionSurchargeAmount" class="form-label small fw-medium"></label>
                    <div class="input-group input-group-sm">
                        <input asp-for="DefaultOptionSurchargeAmount" class="form-control" type="number" step="0.01" min="0" />
                        <span class="input-group-text">€</span>
                    </div>
                    <span asp-validation-for="DefaultOptionSurchargeAmount" class="kiwbi-field-error"></span>
                </div>
            </div>
            <p class="small text-muted mb-0 mt-1">Nombre de la primera opción, que nace marcada como opción por defecto.</p>
        </div>

        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Se aplica a</div>
            <select asp-for="Scope" id="scopeSelect" class="form-select form-select-sm"
                    asp-items="Html.GetEnumSelectList<CustomizationScope>()"></select>
            <p class="small text-muted mb-0 mt-1">
                Si eliges "Toda la promoción" no hace falta seleccionar tipologías ni viviendas.
                Si eliges "Tipología" o "Vivienda", selecciona una o varias en la lista correspondiente.
            </p>
        </div>

        <div class="kiwbi-fieldset" data-scope-panel="Typology" hidden>
            <div class="kiwbi-legend">Tipologías</div>
            <label asp-for="SelectedHousingTypologyIds" class="form-label small fw-medium"></label>
            <select asp-for="SelectedHousingTypologyIds" class="form-select form-select-sm" multiple size="6" asp-items="Model.AvailableTypologies"></select>
        </div>

        <div class="kiwbi-fieldset" data-scope-panel="Unit" hidden>
            <div class="kiwbi-legend">Viviendas</div>
            <label asp-for="SelectedHousingUnitIds" class="form-label small fw-medium"></label>
            <select asp-for="SelectedHousingUnitIds" class="form-select form-select-sm" multiple size="6" asp-items="Model.AvailableUnits"></select>
        </div>

        <div class="d-flex justify-content-end gap-2 pb-2">
            <a asp-controller="Customizations" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                Crear personalización
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var select = document.getElementById('scopeSelect');
            if (!select) return;

            function update() {
                document.querySelectorAll('[data-scope-panel]').forEach(function (panel) {
                    panel.hidden = panel.dataset.scopePanel !== select.value;
                });
            }

            select.addEventListener('change', update);
            update();
        })();
    </script>
}
