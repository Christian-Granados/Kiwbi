@{
    ViewData["Title"] = "Kiwbi — Personalización de viviendas sin Excel ni cadenas de correos";
    Layout = "_LandingLayout";
}

<header class="kiwbi-pub-navbar">
    <nav class="container-xl d-flex align-items-center justify-content-between py-3">
        <a class="kiwbi-pub-logo" asp-controller="Home" asp-action="Index">
            <span class="kiwbi-pub-mark">K</span>
            <span class="kiwbi-pub-logo-text">Kiwbi</span>
        </a>
        <div class="d-flex align-items-center gap-2 gap-sm-3">
            <a class="btn btn-link text-decoration-none text-body fw-semibold" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
            <a class="btn btn-kiwbi-brand rounded-3 fw-semibold px-3" asp-controller="Account" asp-action="Register">Crear cuenta gratis</a>
        </div>
    </nav>
</header>

<main>
    <!-- Hero -->
    <section class="container-xl py-5 py-md-6" id="top">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="kiwbi-pub-hero-badge"><span class="dot"></span>Para promotoras inmobiliarias</span>
                <h1 class="display-5 mt-4">La personalización de viviendas, sin Excel ni cadenas de correos</h1>
                <p class="lead text-muted mt-4" style="max-width:36rem;">
                    Kiwbi centraliza los acabados de todo tu edificio: gremio a gremio, vivienda a vivienda.
                    Tus compradores eligen online antes de cada fecha límite y tú exportas el libro de obra
                    listo para la constructora.
                </p>
                <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
                    <a class="btn btn-kiwbi-brand btn-lg rounded-3 fw-semibold d-inline-flex align-items-center gap-2" asp-controller="Account" asp-action="Register">
                        Crear cuenta gratis
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                    </a>
                    <a class="fw-semibold text-decoration-none d-inline-flex align-items-center gap-1" style="color: var(--kiwbi-brand-primary);" href="#como-funciona">
                        Ver cómo funciona
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="kiwbi-pub-panel-mock">
                    <div class="kiwbi-pub-panel-mock-glow"></div>
                    <div class="kiwbi-pub-panel-card">
                        <div class="kiwbi-pub-panel-chrome">
                            <span class="kiwbi-pub-panel-mark">K</span>
                            <span class="fw-semibold small">Residencial Miravalle</span>
                            <span class="ms-auto badge rounded-pill" style="background:#f0fdfa; color: var(--kiwbi-brand-primary); font-weight:600;">48 viviendas</span>
                        </div>
                        <div class="kiwbi-pub-panel-kpis">
                            <div class="kiwbi-pub-panel-kpi"><div class="value">132</div><div class="label">Confirmadas</div></div>
                            <div class="kiwbi-pub-panel-kpi"><div class="value">54</div><div class="label">Pendientes</div></div>
                            <div class="kiwbi-pub-panel-kpi"><div class="value">88</div><div class="label">Pagadas</div></div>
                        </div>
                        <div class="kiwbi-pub-panel-rows">
                            <div class="kiwbi-pub-panel-row"><span class="kiwbi-pub-panel-unit">1º A</span><span class="kiwbi-pub-panel-trade">Pavimentos</span><span class="kiwbi-pub-panel-bar"><span style="width:100%"></span></span><span class="kiwbi-pub-panel-pct">100%</span></div>
                            <div class="kiwbi-pub-panel-row"><span class="kiwbi-pub-panel-unit">1º B</span><span class="kiwbi-pub-panel-trade">Cocina</span><span class="kiwbi-pub-panel-bar"><span style="width:60%"></span></span><span class="kiwbi-pub-panel-pct">60%</span></div>
                            <div class="kiwbi-pub-panel-row"><span class="kiwbi-pub-panel-unit">2º A</span><span class="kiwbi-pub-panel-trade">Carpintería</span><span class="kiwbi-pub-panel-bar"><span style="width:45%"></span></span><span class="kiwbi-pub-panel-pct">45%</span></div>
                            <div class="kiwbi-pub-panel-row"><span class="kiwbi-pub-panel-unit">3º A</span><span class="kiwbi-pub-panel-trade">Fontanería</span><span class="kiwbi-pub-panel-bar"><span style="width:80%"></span></span><span class="kiwbi-pub-panel-pct">80%</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- KPIs ilustrativos -->
    <section class="kiwbi-pub-kpi-strip">
        <div class="container-xl py-5">
            <div class="row g-4 text-center text-sm-start">
                <div class="col-sm-4">
                    <div class="kiwbi-pub-kpi-value">-70%</div>
                    <p class="text-muted mt-2 mb-0 small">menos tiempo gestionando personalizaciones a mano</p>
                </div>
                <div class="col-sm-4">
                    <div class="kiwbi-pub-kpi-value">100%</div>
                    <p class="text-muted mt-2 mb-0 small">trazabilidad de elecciones y pagos por vivienda</p>
                </div>
                <div class="col-sm-4">
                    <div class="kiwbi-pub-kpi-value">0</div>
                    <p class="text-muted mt-2 mb-0 small">hojas de cálculo perdidas o desactualizadas</p>
                </div>
            </div>
            <p class="text-center text-sm-start mt-4 mb-0" style="font-size:.75rem; color:var(--kiwbi-text-faint);">Cifras ilustrativas y estimadas, a modo de ejemplo.</p>
        </div>
    </section>

    <!-- Cómo funciona -->
    <section class="container-xl py-5 py-md-6" id="como-funciona">
        <div class="mx-auto text-center" style="max-width:40rem;">
            <h2 class="display-6">Cómo funciona</h2>
            <p class="lead text-muted mt-3">Un flujo claro para los dos lados: la promotora lo organiza todo y el comprador decide con tranquilidad.</p>
        </div>

        <div class="text-center mt-4">
            <input type="radio" name="kiwbi-pub-how" id="kiwbi-pub-tab-promotora" class="kiwbi-pub-tab-input" checked>
            <input type="radio" name="kiwbi-pub-how" id="kiwbi-pub-tab-comprador" class="kiwbi-pub-tab-input">
            <div class="kiwbi-pub-tabs">
                <label class="kiwbi-pub-tab" for="kiwbi-pub-tab-promotora">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="1" /><rect x="9" y="16" width="6" height="5" /><line x1="8" y1="7" x2="16" y2="7" /><line x1="8" y1="11" x2="16" y2="11" /></svg>
                    Promotora
                </label>
                <label class="kiwbi-pub-tab" for="kiwbi-pub-tab-comprador">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    Comprador
                </label>
            </div>

            <div class="kiwbi-pub-steps mt-5">
                <ol class="row g-4 list-unstyled kiwbi-pub-steps-promotora text-start">
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="1" /><rect x="9" y="16" width="6" height="5" /><line x1="8" y1="7" x2="16" y2="7" /></svg></span>
                                <span class="kiwbi-pub-step-num">01</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Crea tu promoción y viviendas</h3>
                            <p class="small text-muted mb-0">Da de alta el edificio, sus plantas y puertas, con tipologías reutilizables.</p>
                        </div>
                    </li>
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg></span>
                                <span class="kiwbi-pub-step-num">02</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Define gremios y personalizaciones</h3>
                            <p class="small text-muted mb-0">Cada gremio con su fecha límite y cada personalización con sus opciones y sobrecostes.</p>
                        </div>
                    </li>
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22 6 12 13 2 6" /></svg></span>
                                <span class="kiwbi-pub-step-num">03</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Invita a tus compradores</h3>
                            <p class="small text-muted mb-0">Envía invitaciones por email con Magic Link, sin contraseñas que gestionar.</p>
                        </div>
                    </li>
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg></span>
                                <span class="kiwbi-pub-step-num">04</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Exporta el libro de obra</h3>
                            <p class="small text-muted mb-0">Genera el documento agrupado por gremio, listo para pasar a la constructora.</p>
                        </div>
                    </li>
                </ol>
                <ol class="row g-4 list-unstyled kiwbi-pub-steps-comprador text-start">
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22 6 12 13 2 6" /></svg></span>
                                <span class="kiwbi-pub-step-num">01</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Recibe tu invitación</h3>
                            <p class="small text-muted mb-0">Un email con un enlace directo a tu vivienda, sin registros complicados.</p>
                        </div>
                    </li>
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                                <span class="kiwbi-pub-step-num">02</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Entra y ve tu vivienda</h3>
                            <p class="small text-muted mb-0">Consulta el plano y todas las personalizaciones disponibles para ti.</p>
                        </div>
                    </li>
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 9l5 12 1.8-5.2L21 14z" /><path d="M7.2 2.2l1 1M4 8.6l1 1M2.2 15.4l1.4-.4" /></svg></span>
                                <span class="kiwbi-pub-step-num">03</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Elige tus acabados a tiempo</h3>
                            <p class="small text-muted mb-0">Selecciona cada opción antes de la fecha límite de su gremio.</p>
                        </div>
                    </li>
                    <li class="col-sm-6 col-lg-3">
                        <div class="kiwbi-pub-step">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="kiwbi-pub-step-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg></span>
                                <span class="kiwbi-pub-step-num">04</span>
                            </div>
                            <h3 class="h6 mt-3 mb-2">Sigue tus elecciones y pagos</h3>
                            <p class="small text-muted mb-0">Revisa en todo momento el estado de cada elección y de sus sobrecostes.</p>
                        </div>
                    </li>
                </ol>
            </div>
        </div>
    </section>

    <!-- Beneficios -->
    <section style="border-top:1px solid var(--kiwbi-border); border-bottom:1px solid var(--kiwbi-border); background:var(--kiwbi-bg);">
        <div class="container-xl py-5 py-md-6">
            <div class="mx-auto text-center" style="max-width:40rem;">
                <h2 class="display-6">Pensado para que nada se pierda por el camino</h2>
                <p class="lead text-muted mt-3">Las decisiones de una vivienda son serias. Kiwbi las mantiene ordenadas, trazables y a tiempo.</p>
            </div>
            <div class="row g-4 mt-2">
                <div class="col-sm-6 col-lg-3">
                    <div class="kiwbi-pub-benefit">
                        <span class="kiwbi-pub-benefit-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg></span>
                        <h3 class="h6 mt-3 mb-2">Todo en un solo sitio</h3>
                        <p class="small text-muted mb-0">Se acabaron los Excel sueltos y los correos perdidos: promociones, gremios, opciones y compradores viven en un mismo lugar.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="kiwbi-pub-benefit">
                        <span class="kiwbi-pub-benefit-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="13.5" cy="6.5" r="1" /><circle cx="17.5" cy="10.5" r="1" /><circle cx="8.5" cy="7.5" r="1" /><circle cx="6.5" cy="12.5" r="1" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c1 0 1.65-.75 1.65-1.69 0-.44-.18-.83-.44-1.12-.29-.29-.44-.65-.44-1.13a1.64 1.64 0 0 1 1.67-1.67h1.99C21.5 16.39 24 13.89 24 10.84 24 6 18.46 2 12 2z" /></svg></span>
                        <h3 class="h6 mt-3 mb-2">Tu marca, no la nuestra</h3>
                        <p class="small text-muted mb-0">Cada promotora mantiene su propio logo y colores de cara a sus compradores. Kiwbi queda en segundo plano.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="kiwbi-pub-benefit">
                        <span class="kiwbi-pub-benefit-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg></span>
                        <h3 class="h6 mt-3 mb-2">Bloqueo por fecha límite</h3>
                        <p class="small text-muted mb-0">Cada gremio se cierra automáticamente en su fecha. Nadie decide tarde y la obra no se para por indecisiones.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="kiwbi-pub-benefit">
                        <span class="kiwbi-pub-benefit-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" /><rect x="9" y="3" width="6" height="4" rx="1" /><line x1="9" y1="12" x2="15" y2="12" /><line x1="9" y1="16" x2="15" y2="16" /></svg></span>
                        <h3 class="h6 mt-3 mb-2">Listo para la constructora</h3>
                        <p class="small text-muted mb-0">Exporta el libro de obra agrupado por gremio, con las elecciones y pagos de cada vivienda.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA final -->
    <section class="container-xl py-5 py-md-6" id="signup">
        <div class="kiwbi-pub-cta-band">
            <h2 class="display-6 text-white">Empieza a gestionar tus personalizaciones hoy</h2>
            <p class="lead mx-auto mt-3" style="max-width:34rem; color:#ccfbf1;">Gratuito para empezar, sin necesidad de tarjeta. En marcha en cuestión de minutos.</p>
            <div class="mt-4">
                <a class="btn btn-light btn-lg rounded-3 fw-semibold" style="color: var(--kiwbi-brand-primary);" asp-controller="Account" asp-action="Register">Crear cuenta gratis</a>
            </div>
            <div class="kiwbi-pub-cta-checks mt-4">
                <span>✓ Gratis para empezar</span>
                <span>✓ Sin tarjeta</span>
                <span>✓ En marcha en minutos</span>
            </div>
        </div>
    </section>
</main>

<footer class="kiwbi-pub-footer">
    <div class="container-xl py-4 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
        <a class="kiwbi-pub-logo" asp-controller="Home" asp-action="Index">
            <span class="kiwbi-pub-mark">K</span>
            <span class="kiwbi-pub-logo-text">Kiwbi</span>
        </a>
        <nav class="d-flex flex-wrap align-items-center gap-4 small">
            <a class="text-body text-decoration-none fw-semibold" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
            <a class="text-muted text-decoration-none" href="#">Privacidad</a>
            <a class="text-muted text-decoration-none" href="#">Contacto</a>
        </nav>
        <p class="text-muted small mb-0">© @DateTime.UtcNow.Year Kiwbi</p>
    </div>
</footer>
