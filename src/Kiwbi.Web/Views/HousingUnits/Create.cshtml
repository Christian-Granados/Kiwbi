@model Kiwbi.Web.Models.HousingUnits.CreateHousingUnitViewModel
@{
    ViewData["Title"] = "Nueva vivienda";
}

<h1>Nueva vivienda</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="HousingUnits" asp-action="Create" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="HousingPromotionId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="HousingTypologyId" class="form-label"></label>
                <select asp-for="HousingTypologyId" asp-items="Model.TypologyOptions" class="form-select"></select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Floor" class="form-label"></label>
                <input asp-for="Floor" class="form-control" />
                <span asp-validation-for="Floor" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Door" class="form-label"></label>
                <input asp-for="Door" class="form-control" />
                <span asp-validation-for="Door" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="BuiltAreaSqm" class="form-label"></label>
                <input asp-for="BuiltAreaSqm" class="form-control" />
                <span asp-validation-for="BuiltAreaSqm" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="UsableAreaSqm" class="form-label"></label>
                <input asp-for="UsableAreaSqm" class="form-control" />
                <span asp-validation-for="UsableAreaSqm" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="FloorPlanImageFile" class="form-label"></label>
                <input asp-for="FloorPlanImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                <span asp-validation-for="FloorPlanImageFile" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Crear</button>
            <a asp-controller="HousingUnits" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
