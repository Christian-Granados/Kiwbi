@model Kiwbi.Web.Models.HousingUnits.CreateHousingUnitViewModel
@{
    ViewData["Title"] = "Nueva vivienda";
}

<div class="mx-auto" style="max-width: 48rem;">
    <a asp-controller="HousingUnits" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="d-inline-flex align-items-center gap-1 small text-muted text-decoration-none mb-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
        Volver a Viviendas
    </a>
    <h1 class="h4 mb-1" style="font-weight:600;">Nueva vivienda</h1>
    <p class="small text-muted mb-4">El estado comercial se gestiona desde el listado, no en este formulario.</p>

    <form asp-controller="HousingUnits" asp-action="Create" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">
            <input type="hidden" asp-for="HousingPromotionId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="kiwbi-fieldset">
                <div class="kiwbi-legend">Ubicación</div>
                <div class="row g-3">
                    <div class="col-sm-4">
                        <label asp-for="Floor" class="form-label small fw-medium"></label>
                        <input asp-for="Floor" class="form-control form-control-sm" placeholder="p. ej. 1ª" />
                        <span asp-validation-for="Floor" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="Door" class="form-label small fw-medium"></label>
                        <input asp-for="Door" class="form-control form-control-sm" placeholder="p. ej. A" />
                        <span asp-validation-for="Door" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="HousingTypologyId" class="form-label small fw-medium d-flex justify-content-between">Tipología <span class="text-muted fw-normal small">Opcional</span></label>
                        <select asp-for="HousingTypologyId" asp-items="Model.TypologyOptions" class="form-select form-select-sm"></select>
                    </div>
                </div>
            </div>

            <div class="kiwbi-fieldset">
                <div class="kiwbi-legend">Superficies</div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="BuiltAreaSqm" class="form-label small fw-medium"></label>
                        <div class="input-group input-group-sm">
                            <input asp-for="BuiltAreaSqm" class="form-control" />
                            <span class="input-group-text">m²</span>
                        </div>
                        <span asp-validation-for="BuiltAreaSqm" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="UsableAreaSqm" class="form-label small fw-medium d-flex justify-content-between">Superficie útil <span class="text-muted fw-normal small">Opcional</span></label>
                        <div class="input-group input-group-sm">
                            <input asp-for="UsableAreaSqm" class="form-control" />
                            <span class="input-group-text">m²</span>
                        </div>
                        <span asp-validation-for="UsableAreaSqm" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="kiwbi-fieldset">
                <div class="kiwbi-legend">Plano de la vivienda</div>
                <label asp-for="FloorPlanImageFile" class="kiwbi-dropzone">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14.9A5 5 0 0 1 6 5.3a6.5 6.5 0 0 1 12.6 2A4.5 4.5 0 0 1 18 16H7a3 3 0 0 1-3-3Z" /><path d="M12 12v6M9 15l3-3 3 3" /></svg>
                    <strong>Arrastra una imagen o haz clic para subir</strong>
                    <span class="small kiwbi-dropzone-filename">PNG, JPG, WEBP o PDF · máx. 10 MB</span>
                    <input asp-for="FloorPlanImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" class="visually-hidden" />
                </label>
                <span asp-validation-for="FloorPlanImageFile" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 pb-2">
                <a asp-controller="HousingUnits" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="btn btn-sm btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                    Crear vivienda
                </button>
            </div>
        </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
