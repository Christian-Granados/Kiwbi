@model Kiwbi.Web.Models.HousingPromotions.HousingPromotionViewModel
@{
    ViewData["Title"] = "Detalle de la promoción";
    var available = Model.Units.Count(u => u.Status == "Available");
    var reserved = Model.Units.Count(u => u.Status == "Reserved");
    var sold = Model.Units.Count(u => u.Status == "Sold");
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="kiwbi-breadcrumb mb-1">
    <a asp-controller="HousingPromotions" asp-action="Index" class="text-decoration-none">Promociones</a>
    <span>/</span>
    <span class="current">@Model.Name</span>
</div>

<div class="kiwbi-table-card mb-4">
    <div class="row g-0">
        <div class="col-md-8 p-4 d-flex flex-column justify-content-between gap-3">
            <div>
                <span class="kiwbi-pill-accent">Promoción</span>
                <h1 class="h3 mt-2 mb-1" style="font-weight:600;">@Model.Name</h1>
                <div class="small text-muted d-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                    @Model.Address · @Model.City
                </div>
            </div>

            <div class="d-flex flex-wrap gap-4">
                <div class="kiwbi-stat">
                    <span class="kiwbi-stat-value">@Model.Units.Count</span>
                    <span class="kiwbi-stat-label">Viviendas</span>
                </div>
                <div class="kiwbi-stat">
                    <span class="kiwbi-stat-value"><span class="kiwbi-stat-dot" style="background:#059669;"></span>@available</span>
                    <span class="kiwbi-stat-label">Disponibles</span>
                </div>
                <div class="kiwbi-stat">
                    <span class="kiwbi-stat-value"><span class="kiwbi-stat-dot" style="background:#d97706;"></span>@reserved</span>
                    <span class="kiwbi-stat-label">Reservadas</span>
                </div>
                <div class="kiwbi-stat">
                    <span class="kiwbi-stat-value"><span class="kiwbi-stat-dot" style="background:#94a3b8;"></span>@sold</span>
                    <span class="kiwbi-stat-label">Vendidas</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="HousingPromotions" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z" /></svg>
                    Editar promoción
                </a>
                <form asp-controller="HousingPromotions" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Seguro que quieres eliminar esta promoción?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                        Eliminar
                    </button>
                </form>
            </div>
        </div>
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.MasterPlanImagePath))
            {
                <div class="kiwbi-hub-plano h-100">
                    <img src="~/@Model.MasterPlanImagePath" alt="Plano general" style="max-width:100%;max-height:100%;object-fit:contain;" />
                </div>
            }
            else
            {
                <div class="kiwbi-hub-plano h-100">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M6 21V7l6-4 6 4v14M10 21v-6h4v6" /></svg>
                    <span class="small">Plano no disponible</span>
                </div>
            }
        </div>
    </div>
</div>

<div class="mb-2 text-uppercase small text-muted" style="letter-spacing:.04em;font-size:.7rem;">Secciones</div>
<div class="row row-cols-2 row-cols-sm-3 row-cols-lg-5 g-3 mb-4">
    <div class="col">
        <a class="kiwbi-shortcut-card" asp-controller="HousingTypologies" asp-action="Index" asp-route-promotionId="@Model.Id">
            <span class="kiwbi-shortcut-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg></span>
            <span class="kiwbi-shortcut-label">Tipologías</span>
            <span class="kiwbi-shortcut-hint">Ver <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></span>
        </a>
    </div>
    <div class="col">
        <a class="kiwbi-shortcut-card" asp-controller="HousingUnits" asp-action="Index" asp-route-promotionId="@Model.Id">
            <span class="kiwbi-shortcut-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /></svg></span>
            <span class="kiwbi-shortcut-label">Viviendas</span>
            <span class="kiwbi-shortcut-hint">@Model.Units.Count unidades <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></span>
        </a>
    </div>
    <div class="col">
        <a class="kiwbi-shortcut-card" asp-controller="TradeCategories" asp-action="Index" asp-route-promotionId="@Model.Id">
            <span class="kiwbi-shortcut-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 1.4 1.4l3-3a1 1 0 0 0-1.4-1.4l-3 3ZM3 21l7-7M7 21H3v-4l9.5-9.5a2.1 2.1 0 0 1 3 3L5 21Z" /></svg></span>
            <span class="kiwbi-shortcut-label">Gremios</span>
            <span class="kiwbi-shortcut-hint">Ver <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></span>
        </a>
    </div>
    <div class="col">
        <a class="kiwbi-shortcut-card" asp-controller="Customizations" asp-action="Index" asp-route-promotionId="@Model.Id">
            <span class="kiwbi-shortcut-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><circle cx="9" cy="10" r="1" /><circle cx="14" cy="8" r="1" /><circle cx="15" cy="13" r="1" /></svg></span>
            <span class="kiwbi-shortcut-label">Personalizaciones</span>
            <span class="kiwbi-shortcut-hint">Ver <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></span>
        </a>
    </div>
    <div class="col">
        <a class="kiwbi-shortcut-card" asp-controller="HousingPromotionChoices" asp-action="Index" asp-route-promotionId="@Model.Id">
            <span class="kiwbi-shortcut-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18" /><path d="M18 17V9" /><path d="M13 17V5" /><path d="M8 17v-3" /></svg></span>
            <span class="kiwbi-shortcut-label">Progreso</span>
            <span class="kiwbi-shortcut-hint">Ver <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg></span>
        </a>
    </div>
</div>

<div class="kiwbi-table-card">
    <div class="kiwbi-table-card-header">
        <span class="title">Viviendas de la promoción</span>
        <span class="count">@Model.Units.Count unidades</span>
    </div>
    @if (!Model.Units.Any())
    {
        <div class="kiwbi-empty-state">
            <p>Todavía no hay viviendas dadas de alta en esta promoción.</p>
        </div>
    }
    else
    {
        <table class="kiwbi-table">
            <thead>
                <tr>
                    <th>Planta</th>
                    <th>Puerta</th>
                    <th>Tipología</th>
                    <th class="text-end">Sup. construida</th>
                    <th class="text-end">Sup. útil</th>
                    <th>Estado comercial</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var unit in Model.Units)
                {
                    var badge = unit.Status.ToHousingUnitStatusBadge();
                    <tr>
                        <td class="kiwbi-row-title">@unit.Floor</td>
                        <td>@unit.Door</td>
                        <td class="text-muted">@(unit.TypologyName ?? "-")</td>
                        <td class="text-end">@unit.BuiltAreaSqm m²</td>
                        <td class="text-end">@(unit.UsableAreaSqm is { } usable ? $"{usable} m²" : "-")</td>
                        <td><span class="kiwbi-badge @badge.CssClass">@badge.Label</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
