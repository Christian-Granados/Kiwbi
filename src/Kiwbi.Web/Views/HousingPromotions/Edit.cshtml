@model Kiwbi.Web.Models.HousingPromotions.EditHousingPromotionViewModel
@{
    ViewData["Title"] = "Editar promoción";
}

<div class="kiwbi-breadcrumb mb-1">
    <a asp-controller="HousingPromotions" asp-action="Index" class="text-decoration-none">Promociones</a>
    <span>/</span>
    <a asp-controller="HousingPromotions" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.Name</a>
    <span>/</span>
    <span class="current">Editar</span>
</div>
<h1 class="h4 mb-4" style="font-weight:600;">Editar promoción</h1>

<div style="max-width: 40rem;">
    <form asp-controller="HousingPromotions" asp-action="Edit" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="kiwbi-validation-summary"></div>

        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Datos de la promoción</div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label small fw-medium"></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M6 21V7l6-4 6 4v14M10 21v-6h4v6" /></svg></span>
                        <input asp-for="Name" class="form-control" />
                    </div>
                    <span asp-validation-for="Name" class="kiwbi-field-error"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="City" class="form-label small fw-medium"></label>
                    <input asp-for="City" class="form-control form-control-sm" />
                    <span asp-validation-for="City" class="kiwbi-field-error"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Address" class="form-label small fw-medium"></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg></span>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <span asp-validation-for="Address" class="kiwbi-field-error"></span>
                </div>
            </div>
        </div>

        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Plano general</div>
            <div class="row g-3 align-items-start">
                <div class="col-sm-5">
                    @if (!string.IsNullOrEmpty(Model.MasterPlanImagePath))
                    {
                        <div class="kiwbi-plano-preview">
                            <img src="@Model.MasterPlanImagePath" alt="Plano general" class="kiwbi-plan-zoomable" />
                        </div>
                    }
                    else
                    {
                        <div class="kiwbi-plano-preview">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                            <span class="small">Sin plano cargado</span>
                        </div>
                    }
                </div>
                <div class="col-sm-7 d-flex flex-column gap-2">
                    <label asp-for="MasterPlanImageFile" class="kiwbi-dropzone">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14.9A5 5 0 0 1 6 5.3a6.5 6.5 0 0 1 12.6 2A4.5 4.5 0 0 1 18 16H7a3 3 0 0 1-3-3Z" /><path d="M12 12v6M9 15l3-3 3 3" /></svg>
                        <strong>Arrastra una imagen o haz clic para subir</strong>
                        <span class="small kiwbi-dropzone-filename">PNG, JPG o WEBP · máx. 10 MB</span>
                        <input asp-for="MasterPlanImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="visually-hidden" />
                    </label>
                    <span asp-validation-for="MasterPlanImageFile" class="kiwbi-field-error"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pb-2">
            <a asp-controller="HousingPromotions" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
