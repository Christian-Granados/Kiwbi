@model List<Kiwbi.Web.Models.HousingTypologies.HousingTypologyListItemViewModel>
@{
    ViewData["Title"] = "Tipologías";
    var promotionId = (Guid)ViewBag.PromotionId;
}

<div class="kiwbi-breadcrumb mb-1">
    <span>@ViewBag.PromotionName</span>
    <span>/</span>
    <span class="current">Tipologías</span>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-3">
    <div>
        <h1 class="h4 mb-1" style="font-weight:600;">Tipologías</h1>
        <p class="small text-muted mb-0">Etiquetas que las viviendas pueden compartir para asignar personalizaciones por tipología en lugar de una a una.</p>
    </div>
    <a asp-controller="HousingTypologies" asp-action="Create" asp-route-promotionId="@promotionId" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Nueva tipología
    </a>
</div>

@if (!Model.Any())
{
    <div class="kiwbi-empty-state">
        <div class="kiwbi-empty-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>
        </div>
        <h3>Todavía no hay tipologías dadas de alta</h3>
        <p>Crea la primera tipología para poder asignar viviendas y personalizaciones en bloque.</p>
    </div>
}
else
{
    <div class="kiwbi-table-card">
        <div class="kiwbi-table-card-header">
            <span class="title">Todas las tipologías</span>
            <span class="count">@Model.Count tipologías</span>
        </div>
        <table class="kiwbi-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th class="text-end">Viviendas</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var typology in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="kiwbi-row-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg></span>
                                <span class="kiwbi-row-title">@typology.Name</span>
                            </div>
                        </td>
                        <td class="text-end">@typology.UnitCount</td>
                        <td class="text-end">
                            <a asp-controller="HousingTypologies" asp-action="Edit" asp-route-id="@typology.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form asp-controller="HousingTypologies" asp-action="Delete" asp-route-id="@typology.Id" asp-route-promotionId="@promotionId" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Seguro que quieres eliminar esta tipología?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
