@model Kiwbi.Web.Models.TradeCategories.EditTradeCategoryViewModel
@{
    ViewData["Title"] = "Editar gremio";
}

<h1>Editar gremio</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="TradeCategories" asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="HousingPromotionId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SelectionCutOffDateUtc" class="form-label"></label>
                <input type="datetime-local" asp-for="SelectionCutOffDateUtc" class="form-control" />
                <span asp-validation-for="SelectionCutOffDateUtc" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-controller="TradeCategories" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
