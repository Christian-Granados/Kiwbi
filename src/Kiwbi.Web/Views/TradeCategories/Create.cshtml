@model Kiwbi.Web.Models.TradeCategories.CreateTradeCategoryViewModel
@{
    ViewData["Title"] = "Nuevo gremio";
}

<div class="kiwbi-breadcrumb mb-1">
    <a asp-controller="TradeCategories" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="text-decoration-none">Gremios</a>
    <span>/</span>
    <span class="current">Nuevo gremio</span>
</div>
<h1 class="h4 mb-4" style="font-weight:600;">Nuevo gremio</h1>

<div style="max-width: 38rem;">
    <form asp-controller="TradeCategories" asp-action="Create" method="post" class="d-flex flex-column gap-3">
        <input type="hidden" asp-for="HousingPromotionId" />
        <div asp-validation-summary="ModelOnly" class="kiwbi-validation-summary"></div>
        <div class="kiwbi-fieldset">
            <div class="kiwbi-legend">Datos del gremio</div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label small fw-medium"></label>
                    <input asp-for="Name" class="form-control form-control-sm" placeholder="p. ej. Carpintería" />
                    <span asp-validation-for="Name" class="kiwbi-field-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="SelectionCutOffDateUtc" class="form-label small fw-medium"></label>
                    <input type="datetime-local" asp-for="SelectionCutOffDateUtc" class="form-control form-control-sm" />
                    <span asp-validation-for="SelectionCutOffDateUtc" class="kiwbi-field-error"></span>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 pb-2">
            <a asp-controller="TradeCategories" asp-action="Index" asp-route-promotionId="@Model.HousingPromotionId" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-kiwbi-primary btn-sm d-flex align-items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                Crear gremio
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
