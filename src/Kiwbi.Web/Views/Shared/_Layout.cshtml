<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kiwbi.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kiwbi.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Kiwbi.Web.styles.css" asp-append-version="true" />
    @await Component.InvokeAsync("TenantBranding")
</head>
<body>
@{
    var currentUserName = User.Identity?.Name ?? string.Empty;
    var currentUserInitial = string.IsNullOrWhiteSpace(currentUserName) ? "?" : currentUserName.Trim()[0].ToString().ToUpperInvariant();
}
@if (User.IsInRole("DeveloperAdmin"))
{
    <div class="kiwbi-shell">
        @await Component.InvokeAsync("KiwbiSidebar")
        <div class="kiwbi-main">
            <header class="kiwbi-topbar">
                <button class="kiwbi-collapse-btn" id="kiwbiCollapseBtn" type="button" aria-label="Colapsar menú">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="18" x2="20" y2="18" /></svg>
                </button>
                <div class="flex-grow-1"></div>
                <div class="kiwbi-avatar-chip">
                    <span class="kiwbi-avatar">@currentUserInitial</span>
                    <span class="kiwbi-avatar-name">@currentUserName</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                    <button type="submit" class="kiwbi-icon-btn" title="Cerrar sesión">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    </button>
                </form>
            </header>
            <main role="main" class="kiwbi-content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else if (User.IsInRole("Buyer"))
{
    <header class="kiwbi-buyer-topbar">
        <div class="d-flex align-items-center gap-2">
            <span class="kiwbi-buyer-mark">k</span>
            <div class="lh-sm">
                <div class="fw-semibold" style="font-size:.875rem;">Kiwbi</div>
                <div class="kiwbi-brand-sub">Área del comprador</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="small text-muted d-none d-sm-inline">@currentUserName</span>
            <span class="kiwbi-avatar" style="width:2.25rem;height:2.25rem;font-size:.8rem;">@currentUserInitial</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                <button type="submit" class="kiwbi-icon-btn" title="Cerrar sesión">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                </button>
            </form>
        </div>
    </header>
    @RenderBody()
}
else
{
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Kiwbi.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.IsInRole("Buyer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Buyer" asp-action="Index">Mis viviendas</a>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Kiwbi.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
}
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/kiwbi.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
