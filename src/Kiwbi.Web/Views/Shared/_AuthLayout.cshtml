<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kiwbi</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kiwbi.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Kiwbi.Web.styles.css" asp-append-version="true" />
</head>
<body class="kiwbi-pub">
    @{
        // Only the Accept-invitation flow sets this (Epic 9): tints the backdrop/mark with the
        // inviting promotora's brand color instead of Kiwbi's own teal.
        var authAccentColor = ViewBag.AuthAccentColor as string;
    }
    <main class="kiwbi-pub-auth-shell" style="@(authAccentColor is not null ? $"--kiwbi-pub-glow: {authAccentColor};" : "")">
        <div class="kiwbi-pub-auth-backdrop"></div>
        <div class="kiwbi-pub-auth-wrap">
            @RenderBody()
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/kiwbi.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
