@model Kiwbi.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = "Registro de Promotora";
    Layout = "_AuthLayout";
}

<div class="kiwbi-pub-auth-brand">
    <span class="kiwbi-pub-mark" style="width:2.25rem;height:2.25rem;font-size:1rem;">K</span>
    <span class="kiwbi-pub-logo-text" style="font-size:1.25rem;">Kiwbi</span>
    <p class="text-muted small mb-0">Crea la cuenta de tu promotora</p>
</div>

<div class="kiwbi-pub-auth-card">
    <div class="kiwbi-pub-auth-tabs">
        <a class="kiwbi-pub-auth-tab" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        <span class="kiwbi-pub-auth-tab active">Crear cuenta</span>
    </div>

    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="kiwbi-validation-summary mb-3"></div>
        <div class="mb-3">
            <label asp-for="CompanyName" class="form-label small fw-semibold"></label>
            <div class="kiwbi-pub-field-icon">
                <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="1" /><rect x="9" y="16" width="6" height="5" /><line x1="8" y1="7" x2="16" y2="7" /><line x1="8" y1="11" x2="16" y2="11" /></svg></span>
                <input asp-for="CompanyName" class="form-control" autocomplete="organization" />
            </div>
            <span asp-validation-for="CompanyName" class="kiwbi-field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label small fw-semibold"></label>
            <div class="kiwbi-pub-field-icon">
                <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22 6 12 13 2 6" /></svg></span>
                <input asp-for="Email" class="form-control" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="kiwbi-field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label small fw-semibold"></label>
            <div class="kiwbi-pub-field-icon">
                <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg></span>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
            </div>
            <span asp-validation-for="Password" class="kiwbi-field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
            <div class="kiwbi-pub-field-icon">
                <span class="icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg></span>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="kiwbi-field-error"></span>
        </div>
        <button type="submit" class="btn btn-kiwbi-brand w-100 fw-semibold">Crear cuenta gratis</button>
        <p class="kiwbi-pub-auth-hint mt-3 mb-0">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
            Empieza a usar Kiwbi en minutos, sin tarjeta de crédito.
        </p>
    </form>
</div>

<p class="kiwbi-pub-auth-footer-link">¿Ya tienes cuenta? <a asp-controller="Account" asp-action="Login">Inicia sesión</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
