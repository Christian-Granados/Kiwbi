@{
    ViewData["Title"] = "Revisa tu correo";
    Layout = "_AuthLayout";
}

<div class="kiwbi-pub-auth-brand">
    <span class="kiwbi-pub-mark" style="width:2.25rem;height:2.25rem;font-size:1rem;">K</span>
    <span class="kiwbi-pub-logo-text" style="font-size:1.25rem;">Kiwbi</span>
</div>

<div class="kiwbi-pub-auth-card text-center">
    <p class="mb-1 fw-semibold">Revisa tu correo</p>
    <p class="small text-muted">Si existe una cuenta con ese correo electrónico, te hemos enviado un enlace para restablecer tu contraseña. Puede tardar unos minutos en llegar.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-kiwbi-brand w-100 fw-semibold mt-2">Volver a iniciar sesión</a>
</div>
