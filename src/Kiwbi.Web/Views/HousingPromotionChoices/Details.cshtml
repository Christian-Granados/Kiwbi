@model List<Kiwbi.Web.Models.HousingPromotionChoices.TradeCategoryChoicesViewModel>
@using Kiwbi.Domain.Choices
@{
    ViewData["Title"] = "Detalle de personalizaciones";
    var promotionId = (Guid)ViewBag.PromotionId;
    var housingUnitId = (Guid)ViewBag.HousingUnitId;
    var housingUnitLabel = (string)ViewBag.HousingUnitLabel;
}

<h1>Personalizaciones — @housingUnitLabel</h1>
<p>
    <a asp-controller="HousingPromotionChoices" asp-action="Index" asp-route-promotionId="@promotionId" class="btn btn-outline-secondary btn-sm">&larr; Volver al progreso de la promoción</a>
</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.Any())
{
    <p>Esta vivienda todavía no tiene personalizaciones aplicables.</p>
}
else
{
    @foreach (var tradeCategory in Model)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><strong>@tradeCategory.TradeCategoryName</strong></span>
                @if (tradeCategory.IsExpired)
                {
                    <span class="badge bg-secondary">Plazo finalizado (@tradeCategory.SelectionCutOffDateUtc.ToString("dd/MM/yyyy"))</span>
                }
                else
                {
                    <span class="badge bg-success">Plazo hasta el @tradeCategory.SelectionCutOffDateUtc.ToString("dd/MM/yyyy")</span>
                }
            </div>
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Personalización</th>
                        <th>Opción efectiva</th>
                        <th>Sobrecoste</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customization in tradeCategory.Customizations)
                    {
                        var (badgeClass, statusLabel) = customization.Status switch
                        {
                            HomeCustomizationChoiceStatus.Pending => ("bg-secondary", "Pendiente"),
                            HomeCustomizationChoiceStatus.Selected => ("bg-info text-dark", "Seleccionada"),
                            HomeCustomizationChoiceStatus.Confirmed => ("bg-primary", "Confirmada"),
                            HomeCustomizationChoiceStatus.Paid => ("bg-success", "Pagada"),
                            _ => ("bg-light text-dark", customization.Status.ToString()),
                        };
                        var canConfirm = tradeCategory.IsExpired && customization.Status is HomeCustomizationChoiceStatus.Pending or HomeCustomizationChoiceStatus.Selected;
                        var canMarkAsPaid = customization.Status == HomeCustomizationChoiceStatus.Confirmed;
                        <tr>
                            <td>@customization.CustomizationName</td>
                            <td>@(customization.EffectiveOptionName ?? "-")</td>
                            <td>@(customization.EffectiveOptionSurchargeAmount is { } surcharge ? $"{surcharge:C}" : "-")</td>
                            <td><span class="badge @badgeClass">@statusLabel</span></td>
                            <td>
                                @if (canConfirm)
                                {
                                    <form asp-controller="HousingPromotionChoices" asp-action="Confirm" method="post" class="d-inline">
                                        <input type="hidden" name="housingUnitId" value="@housingUnitId" />
                                        <input type="hidden" name="customizationId" value="@customization.CustomizationId" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Confirmar</button>
                                    </form>
                                }
                                @if (canMarkAsPaid)
                                {
                                    <form asp-controller="HousingPromotionChoices" asp-action="MarkAsPaid" method="post" class="d-inline">
                                        <input type="hidden" name="housingUnitId" value="@housingUnitId" />
                                        <input type="hidden" name="customizationId" value="@customization.CustomizationId" />
                                        <button type="submit" class="btn btn-outline-success btn-sm">Marcar como pagada</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
