@model List<Kiwbi.Web.Models.Buyer.TradeCategoryCustomizationsViewModel>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Personalizaciones de la vivienda";
    var housingUnitId = (Guid)ViewData["HousingUnitId"]!;
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<meta name="csrf-token" content="@csrfToken" />

<h1>Personalizaciones de tu vivienda</h1>
<p>
    <a asp-controller="Buyer" asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Volver a mis viviendas</a>
</p>

@if (!Model.Any())
{
    <p>Esta vivienda todavía no tiene personalizaciones disponibles.</p>
}
else
{
    @foreach (var tradeCategory in Model)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><strong>@tradeCategory.TradeCategoryName</strong></span>
                @if (tradeCategory.IsExpired)
                {
                    <span class="badge bg-secondary">Plazo finalizado (@tradeCategory.SelectionCutOffDateUtc.ToString("dd/MM/yyyy"))</span>
                }
                else
                {
                    <span class="badge bg-success">Plazo hasta el @tradeCategory.SelectionCutOffDateUtc.ToString("dd/MM/yyyy")</span>
                }
            </div>
            <div class="card-body">
                @foreach (var customization in tradeCategory.Customizations)
                {
                    @await Html.PartialAsync("_CustomizationCard", new Kiwbi.Web.Models.Buyer.CustomizationCardViewModel
                    {
                        HousingUnitId = housingUnitId,
                        Customization = customization,
                    })
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script src="~/lib/htmx.org/htmx.min.js"></script>
    <script src="~/lib/alpinejs/cdn.min.js" defer></script>
    <script>
        document.body.addEventListener('htmx:configRequest', function (evt) {
            evt.detail.headers['X-CSRF-TOKEN'] = document.querySelector('meta[name="csrf-token"]').content;
        });
    </script>
}

