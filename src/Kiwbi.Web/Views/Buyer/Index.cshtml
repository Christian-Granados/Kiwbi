@model List<Kiwbi.Web.Models.Buyer.BuyerHousingUnitViewModel>
@{
    ViewData["Title"] = "Mis viviendas";
}

<div class="mx-auto px-4 py-5" style="max-width: 62rem;">
    <h1 class="h4" style="font-weight:600;">Mis viviendas</h1>
    <p class="small text-muted">Consulta cada vivienda y personaliza sus acabados antes de la fecha límite.</p>

    @if (!Model.Any())
    {
        <div class="kiwbi-empty-state">
            <p>Todavía no tienes ninguna vivienda vinculada a tu cuenta.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mt-1">
            @foreach (var unit in Model)
            {
                <div class="col">
                    <a asp-controller="Buyer" asp-action="HousingUnit" asp-route-id="@unit.HousingUnitId" class="kiwbi-buyer-card">
                        @if (!string.IsNullOrWhiteSpace(unit.FloorPlanImagePath))
                        {
                            <div class="kiwbi-buyer-card-plano">
                                <img src="@unit.FloorPlanImagePath" alt="Plano de la vivienda" style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                        }
                        else
                        {
                            <div class="kiwbi-buyer-card-plano">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M6 21V7l6-4 6 4v14M10 21v-6h4v6" /></svg>
                            </div>
                        }
                        <div class="kiwbi-buyer-card-body">
                            <div class="fw-semibold" style="font-size:.9rem;">@unit.HousingPromotionName</div>
                            <div class="small text-muted d-flex align-items-center gap-1 mt-1">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                                @unit.City
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <span class="kiwbi-chip">@unit.Floor</span>
                                <span class="kiwbi-chip">Puerta @unit.Door</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
